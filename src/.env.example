APP_NAME="MSC Report"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=msc_report
DB_USERNAME=msc_report
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- MEDSCI ACC SSO (sso_integration_guide.md) ----
# Client ID / Secret ได้จากการลงทะเบียนระบบย่อยที่ https://www.medsci.up.ac.th/msc_acc/admin/clients.php
# Redirect URI ที่ต้องลงทะเบียน: ${APP_URL}/auth/sso/callback
MEDSCI_SSO_BASE_URL=https://www.medsci.up.ac.th/msc_acc
MEDSCI_SSO_CLIENT_ID=
MEDSCI_SSO_CLIENT_SECRET=
MEDSCI_SSO_VERIFY_SSL=true
# username ที่ได้สิทธิ์ admin อัตโนมัติเมื่อล็อกอิน (คั่นด้วย ,)
APP_ADMIN_USERNAMES=wittaya.su
# ปุ่มเข้าสู่ระบบแบบไม่ผ่าน SSO สำหรับเครื่อง dev เท่านั้น (ทำงานเฉพาะ APP_ENV=local)
DEV_LOGIN_ENABLED=true
DEV_LOGIN_USERNAME=wittaya.su

# ---- AI ภายในองค์กร: UP AI Connect (OpenAI-compatible) — Admin แก้ทับได้ที่หน้า "ตั้งค่า AI" ----
# API Key ของแต่ละคนใส่ที่หน้า "AI ของฉัน" (ไม่ใส่ในไฟล์นี้)
AI_FORMAT=openai
AI_BASE_URL=https://gen.ai.kku.ac.th/upacth/api/v1
AI_AUTH_STYLE=bearer
AI_MODEL_SMART=claude-sonnet-5.5
AI_MODEL_FAST=gemini-2.5-flash-lite
AI_JSON_MODE=false
AI_TIMEOUT=90

# ---- ส่งออก PDF/ภาพ (Headless Chrome) ----
# Docker: /usr/bin/chromium · IIS: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=/usr/bin/chromium
CHROME_NO_SANDBOX=true
# URL ภายในเครื่องที่ Chrome ใช้เปิดหน้า render — Docker: http://web · IIS: http://localhost
EXPORT_INTERNAL_URL=http://web
EXPORT_RETENTION_DAYS=7
